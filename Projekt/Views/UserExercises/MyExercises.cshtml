@model IEnumerable<Projekt.Models.UserExercise>

@{
    ViewData["Title"] = "Moje ćwiczenia";
    string? currentStatus = ViewBag.CurrentStatus;
}

<div class="page-header mb-4">
    <h1 class="display-5 fw-bold">Moje ćwiczenia</h1>
    <p class="text-muted">Tutaj znajdują się ćwiczenia dodane do Twojego planu.</p>
</div>

<div class="card shadow-sm p-3 mb-4">
    <form method="get" class="row g-3 align-items-end">

        <div class="col-md-8">
            <label class="form-label fw-bold">Filtr statusu</label>
            <select name="status" class="form-select">
                @if (string.IsNullOrEmpty(currentStatus))
                {
                    <option value="" selected>Wszystkie</option>
                }
                else
                {
                    <option value="">Wszystkie</option>
                }

                @if (currentStatus == "completed")
                {
                    <option value="completed" selected>Wykonane</option>
                }
                else
                {
                    <option value="completed">Wykonane</option>
                }

                @if (currentStatus == "active")
                {
                    <option value="active" selected>Do wykonania</option>
                }
                else
                {
                    <option value="active">Do wykonania</option>
                }
            </select>
        </div>

        <div class="col-md-4 d-flex gap-2">
            <button type="submit" class="btn btn-primary w-100">
                🔍 Filtruj
            </button>

            <a asp-action="MyExercises" class="btn btn-secondary w-100">
                Wyczyść
            </a>
        </div>

    </form>
</div>

@if (!Model.Any())
{
    <div class="card p-5 text-center shadow">
        <div class="fs-1 mb-3">📭</div>

        <h3>Nie masz jeszcze żadnych ćwiczeń</h3>

        <p class="text-muted">
            Przejdź do dostępnych ćwiczeń i dodaj pierwsze ćwiczenie do planu.
        </p>

        <a asp-action="Available" class="btn btn-primary">
            Zobacz dostępne ćwiczenia
        </a>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-md-4">
                <div class="card h-100 p-4 shadow-lg border-0 exercise-card">

                    <div class="fs-1 mb-3">
                        @(item.IsCompleted ? "✅" : "⭕")
                    </div>

                    <h4 class="fw-bold">@item.Exercise?.Name</h4>

                    <div class="mb-3">
                        <span class="badge bg-primary">
                            @item.Exercise?.DifficultyLevel
                        </span>

                        <span class="badge bg-success">
                            ⏱ @item.Exercise?.Duration min
                        </span>
                    </div>

                    <p class="text-muted">@item.Exercise?.Category</p>

                    <div class="alert alert-light mt-3">
                        <strong>🏋️ Sprzęt:</strong>
                        @item.Exercise?.Equipment
                    </div>

                    <p>
                        Status:
                        @if (item.IsCompleted)
                        {
                            <span class="badge bg-success">
                                Wykonano
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">
                                Do wykonania
                            </span>
                        }
                    </p>

                    <div class="progress mb-3" style="height:10px;">
                        <div class="progress-bar bg-success"
                             style="width:@(item.IsCompleted ? "100" : "0")%">
                        </div>
                    </div>

                    @if (item.IsCompleted)
                    {
                        <div class="alert alert-success mt-auto mb-3">
                            ✅ Ćwiczenie zostało wykonane.

                            @if (item.CompletedAt != null)
                            {
                                <br />
                                <strong>Data potwierdzenia:</strong>
                                @item.CompletedAt?.ToString("yyyy-MM-dd HH:mm")
                            }
                        </div>

                        <a asp-action="Available"
                           class="btn btn-outline-primary mt-auto">
                            ➕ Dodaj ponownie
                        </a>
                    }
                    else
                    {
                        <div class="d-flex gap-2 mt-auto flex-wrap">

                            <a asp-action="Execute"
                               asp-route-id="@item.Id"
                               class="btn btn-primary">
                                ▶ Wykonuj
                            </a>

                            <form asp-action="Complete" method="post">
                                <input type="hidden" name="id" value="@item.Id" />

                                <button class="btn btn-success">
                                    ✅ Wykonano
                                </button>
                            </form>

                            <form asp-action="Remove" method="post">
                                <input type="hidden" name="id" value="@item.Id" />

                                <button class="btn btn-danger">
                                    🗑 Usuń
                                </button>
                            </form>

                        </div>
                    }

                </div>
            </div>
        }
    </div>
}