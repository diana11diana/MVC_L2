@{
    ViewData["Title"] = "Strona główna";
}

<div class="guest-hero">

    <div class="guest-hero-content">
        <div class="hero-badge-small">🔥 Twój osobisty plan treningowy</div>

        <h1>
            Trenuj mądrzej,<br />
            śledź postępy szybciej
        </h1>

        <p>
            Menedżer Treningów Fitness pomaga wybierać ćwiczenia,
            budować własny plan i kontrolować efekty każdego dnia.
        </p>

        <div class="hero-actions">
            <a asp-area="Identity"
               asp-page="/Account/Login"
               class="btn btn-primary btn-lg">
                🔑 Zaloguj się
            </a>

            <a asp-area="Identity"
               asp-page="/Account/Register"
               class="btn btn-success btn-lg">
                ➕ Zacznij za darmo
            </a>
        </div>
    </div>

    <div class="guest-hero-visual">
        <div class="phone-card">
            <div class="phone-top">🏋️ Plan dnia</div>

            <div class="workout-item">
                <span>✅ Rozgrzewka</span>
                <strong>10 min</strong>
            </div>

            <div class="workout-item">
                <span>💪 Trening siłowy</span>
                <strong>25 min</strong>
            </div>

            <div class="workout-item">
                <span>🧘 Rozciąganie</span>
                <strong>12 min</strong>
            </div>

            <div class="progress-line">
                <div></div>
            </div>

            <p>Dzisiejszy postęp: <strong>72%</strong></p>
        </div>
    </div>

</div>

<div class="row g-4 mt-5">

    <div class="col-md-4">
        <div class="marketing-card">
            <div class="marketing-icon">💪</div>
            <h3>Ćwiczenia dopasowane do Ciebie</h3>
            <p>
                Wybieraj spośród wielu ćwiczeń i twórz własny plan treningowy
                zgodny z Twoim poziomem.
            </p>
        </div>
    </div>

    <div class="col-md-4">
        <div class="marketing-card">
            <div class="marketing-icon">📈</div>
            <h3>Monitorowanie postępów</h3>
            <p>
                Sprawdzaj wykonane ćwiczenia, aktualny plan oraz codzienną aktywność.
            </p>
        </div>
    </div>

    <div class="col-md-4">
        <div class="marketing-card">
            <div class="marketing-icon">📝</div>
            <h3>Ankieta treningowa</h3>
            <p>
                Wypełnij krótką ankietę dnia i otrzymaj ćwiczenia pasujące
                do Twojego samopoczucia.
            </p>
        </div>
    </div>

</div>

<div class="stats-section mt-5">

    <div class="stat-box">
        <h2>150+</h2>
        <p>ćwiczeń w bazie</p>
    </div>

    <div class="stat-box">
        <h2>3</h2>
        <p>poziomy trudności</p>
    </div>

    <div class="stat-box">
        <h2>10+</h2>
        <p>kategorii treningowych</p>
    </div>

    <div class="stat-box">
        <h2>24/7</h2>
        <p>dostęp do planu</p>
    </div>

</div>

<div class="cta-section mt-5 mb-5">
    <h2>Gotowa na lepszy trening?</h2>
    <p>
        Załóż konto i zacznij budować swój plan już teraz.
    </p>

    <a asp-area="Identity"
       asp-page="/Account/Register"
       class="btn btn-light btn-lg">
        🚀 Rozpocznij trening
    </a>
</div>

<style>
    .guest-hero {
        min-height: 520px;
        display: grid;
        grid-template-columns: 1.2fr .8fr;
        gap: 40px;
        align-items: center;
        padding: 70px 60px;
        border-radius: 36px;
        background:
            radial-gradient(circle at top left, rgba(255,255,255,.25), transparent 30%),
            linear-gradient(135deg, #2563eb, #14b8a6);
        color: white;
        box-shadow: 0 30px 70px rgba(37, 99, 235, .28);
    }

    .hero-badge-small {
        display: inline-block;
        background: rgba(255,255,255,.18);
        border: 1px solid rgba(255,255,255,.3);
        padding: 10px 18px;
        border-radius: 999px;
        font-weight: 700;
        margin-bottom: 20px;
    }

    .guest-hero h1 {
        font-size: 64px;
        line-height: 1.05;
        font-weight: 900;
        margin-bottom: 24px;
    }

    .guest-hero p {
        font-size: 20px;
        max-width: 650px;
        opacity: .95;
    }

    .hero-actions {
        margin-top: 32px;
        display: flex;
        gap: 16px;
        flex-wrap: wrap;
    }

    .hero-actions .btn {
        padding: 14px 24px;
        border-radius: 18px;
        font-weight: 800;
        box-shadow: 0 15px 35px rgba(15,23,42,.18);
    }

    .guest-hero-visual {
        display: flex;
        justify-content: center;
    }

    .phone-card {
        width: 330px;
        background: rgba(255,255,255,.95);
        color: #0f172a;
        border-radius: 32px;
        padding: 28px;
        box-shadow: 0 30px 60px rgba(15,23,42,.25);
        transform: rotate(3deg);
    }

    .phone-top {
        font-size: 22px;
        font-weight: 900;
        margin-bottom: 22px;
    }

    .workout-item {
        display: flex;
        justify-content: space-between;
        background: #f8fafc;
        padding: 14px;
        border-radius: 16px;
        margin-bottom: 12px;
        font-weight: 700;
    }

    .progress-line {
        background: #e5e7eb;
        height: 14px;
        border-radius: 999px;
        margin: 22px 0 12px;
        overflow: hidden;
    }

    .progress-line div {
        width: 72%;
        height: 100%;
        background: linear-gradient(135deg, #22c55e, #14b8a6);
    }

    .marketing-card {
        background: white;
        border-radius: 28px;
        padding: 34px;
        height: 100%;
        box-shadow: 0 18px 40px rgba(15, 23, 42, .10);
        transition: .25s;
        border: 1px solid rgba(226,232,240,.9);
    }

    .marketing-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 28px 60px rgba(15, 23, 42, .16);
    }

    .marketing-icon {
        width: 66px;
        height: 66px;
        border-radius: 22px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #eff6ff;
        font-size: 34px;
        margin-bottom: 20px;
    }

    .marketing-card h3 {
        font-weight: 900;
        color: #0f172a;
    }

    .marketing-card p {
        color: #64748b;
        font-size: 16px;
    }

    .stats-section {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 22px;
    }

    .stat-box {
        background: white;
        border-radius: 28px;
        padding: 30px;
        text-align: center;
        box-shadow: 0 18px 40px rgba(15,23,42,.10);
    }

    .stat-box h2 {
        font-size: 42px;
        font-weight: 900;
        color: #2563eb;
    }

    .stat-box p {
        color: #64748b;
        font-weight: 700;
        margin: 0;
    }

    .cta-section {
        border-radius: 36px;
        background: linear-gradient(135deg, #0f172a, #1e293b);
        color: white;
        padding: 55px;
        text-align: center;
        box-shadow: 0 25px 60px rgba(15,23,42,.25);
    }

    .cta-section h2 {
        font-size: 42px;
        font-weight: 900;
    }

    .cta-section p {
        color: #cbd5e1;
        font-size: 18px;
        margin-bottom: 24px;
    }

    @@media (max-width: 900px) {
        .guest-hero {
            grid-template-columns: 1fr;
            padding: 45px 30px;
            text-align: center;
        }

        .guest-hero h1 {
            font-size: 42px;
        }

        .hero-actions {
            justify-content: center;
        }

        .stats-section {
            grid-template-columns: 1fr 1fr;
        }
    }
</style>