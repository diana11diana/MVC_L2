@{
    ViewData["Title"] = "Premium";
}

<div class="container py-5">

    <div class="premium-hero text-center mb-5">
        <div class="premium-icon">⭐</div>
        <h1>Premium Fitness</h1>
        <p>
            Odblokuj dodatkowe możliwości i trenuj jeszcze skuteczniej.
        </p>
    </div>

    <div class="row g-4">

        <div class="col-md-6">
            <div class="premium-card h-100">
                <h2>Free</h2>
                <div class="price">0 zł</div>

                <ul>
                    <li>✅ Dostęp do ćwiczeń</li>
                    <li>✅ Własny plan treningowy</li>
                    <li>✅ Podstawowe statystyki</li>
                    <li>✅ Filtrowanie ćwiczeń</li>
                </ul>

                <button class="btn btn-outline-primary w-100" disabled>
                    Aktualny plan
                </button>
            </div>
        </div>

        <div class="col-md-6">
            <div class="premium-card premium-highlight h-100">
                <div class="badge bg-warning text-dark mb-3">
                    Najlepszy wybór
                </div>

                <h2>Premium</h2>
                <div class="price">19,99 zł / miesiąc</div>

                <ul>
                    <li>⭐ Indywidualne rekomendacje</li>
                    <li>⭐ Zaawansowane statystyki</li>
                    <li>⭐ Plany treningowe Premium</li>
                    <li>⭐ Dodatkowe ankiety treningowe</li>
                    <li>⭐ Priorytetowy rozwój funkcji</li>
                </ul>

                <a asp-controller="Premium"
                   asp-action="Payment"
                   class="btn btn-warning w-100 btn-lg">
                    Kup Premium
                </a>
            </div>
        </div>

    </div>

</div>

<div class="modal fade" id="premiumModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content text-center">

            <div class="modal-header bg-warning">
                <h5 class="modal-title fw-bold">⭐ Premium</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body p-5">
                <div class="fs-1 mb-3">🚀</div>

                <h3>Funkcja demonstracyjna</h3>

                <p class="text-muted">
                    Moduł płatności Premium jest zaplanowany jako dalszy rozwój aplikacji.
                    W tej wersji pokazuje koncepcję subskrypcji.
                </p>

                <button class="btn btn-primary mt-3" data-bs-dismiss="modal">
                    Rozumiem
                </button>
            </div>

        </div>
    </div>
</div>

<style>
    .premium-hero {
        background: linear-gradient(135deg, #0f172a, #2563eb);
        color: white;
        border-radius: 36px;
        padding: 60px 30px;
        box-shadow: 0 25px 60px rgba(15, 23, 42, .25);
    }

    .premium-icon {
        font-size: 60px;
        margin-bottom: 15px;
    }

    .premium-hero h1 {
        font-size: 52px;
        font-weight: 900;
    }

    .premium-hero p {
        font-size: 20px;
        color: #dbeafe;
    }

    .premium-card {
        background: white;
        border-radius: 30px;
        padding: 42px;
        box-shadow: 0 20px 45px rgba(15, 23, 42, .12);
        border: 1px solid #e2e8f0;
    }

    .premium-highlight {
        border: 3px solid #facc15;
        transform: scale(1.03);
    }

    .premium-card h2 {
        font-weight: 900;
        color: #0f172a;
    }

    .price {
        font-size: 32px;
        font-weight: 900;
        color: #2563eb;
        margin: 18px 0 25px;
    }

    .premium-card ul {
        list-style: none;
        padding: 0;
        margin-bottom: 30px;
    }

    .premium-card li {
        padding: 10px 0;
        font-weight: 600;
        color: #334155;
    }
</style>