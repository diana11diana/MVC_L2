@model IEnumerable<Projekt.Models.Exercise>

@{
    ViewData["Title"] = "Zarządzaj ćwiczeniami";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>💪 Zarządzaj ćwiczeniami</h2>
            <p class="text-muted">
                Lista wszystkich ćwiczeń w systemie.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-success btn-lg">
            ➕ Dodaj ćwiczenie
        </a>
    </div>

    <div class="row">

        @foreach (var item in Model)
        {
            <div class="col-lg-4 col-md-6 mb-4">

                <div class="card shadow h-100">

                    <div class="card-header bg-dark text-white">
                        <h5 class="mb-0">@item.Name</h5>
                    </div>

                    <div class="card-body">

                        <p>
                            <strong>Kategoria:</strong><br />
                            @item.Category
                        </p>

                        <p>
                            <strong>Poziom trudności:</strong><br />
                            <span class="badge bg-primary">
                                @item.DifficultyLevel
                            </span>
                        </p>

                        <p>
                            <strong>Czas:</strong><br />
                            @item.Duration min
                        </p>

                        <p>
                            <strong>Opis:</strong><br />
                            @item.Description
                        </p>

                    </div>

                    <div class="card-footer text-center">

                        <a asp-action="Details"
                           asp-route-id="@item.Id"
                           class="btn btn-info btn-sm">
                            Szczegóły
                        </a>

                        <a asp-action="Edit"
                           asp-route-id="@item.Id"
                           class="btn btn-warning btn-sm">
                            Edytuj
                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@item.Id"
                           class="btn btn-danger btn-sm">
                            Usuń
                        </a>

                    </div>

                </div>

            </div>
        }

    </div>

</div>