@model Projekt.Models.Exercise

@{
    ViewData["Title"] = "Dodaj ćwiczenie";
}

<div class="container mt-4">

    <div class="card shadow border-0">

        <div class="card-header bg-success text-white">
            <h2 class="mb-0">➕ Dodaj nowe ćwiczenie</h2>
        </div>

        <div class="card-body">

            <form asp-action="Create" method="post">

                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-bold">Nazwa ćwiczenia</label>
                    <input asp-for="Name" class="form-control" placeholder="np. Przysiady" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Category" class="form-label fw-bold">Kategoria</label>
                    <select asp-for="Category" class="form-select">
                        <option value="Siłowe">Siłowe</option>
                        <option value="Cardio">Cardio</option>
                        <option value="Mobilność">Mobilność</option>
                        <option value="Core">Core</option>
                        <option value="Nogi">Nogi</option>
                        <option value="Ramiona">Ramiona</option>
                        <option value="Plecy">Plecy</option>
                        <option value="Brzuch">Brzuch</option>
                        <option value="Rozciąganie">Rozciąganie</option>
                        <option value="Relaksacyjne">Relaksacyjne</option>
                    </select>
                    <span asp-validation-for="Category" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="DifficultyLevel" class="form-label fw-bold">Poziom trudności</label>
                    <select asp-for="DifficultyLevel" class="form-select">
                        <option value="Łatwy">Łatwy</option>
                        <option value="Średni">Średni</option>
                        <option value="Trudny">Trudny</option>
                    </select>
                    <span asp-validation-for="DifficultyLevel" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-3 mb-3">
                        <label asp-for="Duration" class="form-label fw-bold">Czas (min)</label>
                        <input asp-for="Duration" class="form-control" />
                        <span asp-validation-for="Duration" class="text-danger"></span>
                    </div>

                    <div class="col-md-3 mb-3">
                        <label asp-for="Sets" class="form-label fw-bold">Serie</label>
                        <input asp-for="Sets" class="form-control" />
                        <span asp-validation-for="Sets" class="text-danger"></span>
                    </div>

                    <div class="col-md-3 mb-3">
                        <label asp-for="Repetitions" class="form-label fw-bold">Powtórzenia</label>
                        <input asp-for="Repetitions" class="form-control" />
                        <span asp-validation-for="Repetitions" class="text-danger"></span>
                    </div>

                    <div class="col-md-3 mb-3">
                        <label asp-for="RestSeconds" class="form-label fw-bold">Przerwa (s)</label>
                        <input asp-for="RestSeconds" class="form-control" />
                        <span asp-validation-for="RestSeconds" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Equipment" class="form-label fw-bold">Potrzebny sprzęt</label>
                    <input asp-for="Equipment" class="form-control" placeholder="np. Mata, hantle, guma oporowa albo brak sprzętu" />
                    <span asp-validation-for="Equipment" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label fw-bold">Krótki opis</label>
                    <textarea asp-for="Description" class="form-control" rows="3"
                              placeholder="Krótki opis ćwiczenia"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Instruction" class="form-label fw-bold">Instrukcja wykonania</label>
                    <textarea asp-for="Instruction" class="form-control" rows="6"
                              placeholder="Opisz dokładnie, jak wykonać ćwiczenie krok po kroku"></textarea>
                    <span asp-validation-for="Instruction" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-success">
                    💾 Zapisz
                </button>

                <a asp-action="Index" class="btn btn-secondary ms-2">
                    ↩ Powrót
                </a>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}