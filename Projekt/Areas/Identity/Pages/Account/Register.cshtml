@page
@model Projekt.Areas.Identity.Pages.Account.RegisterModel

@{
    ViewData["Title"] = "Rejestracja";
    Layout = "/Views/Shared/_Layout.cshtml";
}

<div class="auth-register-page">
    <div class="auth-register-card">

        <div class="text-center mb-4">
            <div class="auth-register-icon">🏋️</div>
            <h1>Utwórz konto</h1>
            <p>Zarejestruj się i rozpocznij swój plan treningowy.</p>
        </div>

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Input.FullName" class="form-label fw-bold">Imię i nazwisko</label>
                <input asp-for="Input.FullName" class="form-control" placeholder="Jan Kowalski" />
                <span asp-validation-for="Input.FullName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label fw-bold">Email</label>
                <input asp-for="Input.Email" class="form-control" placeholder="name@example.com" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Password" class="form-label fw-bold">Hasło</label>
                <input asp-for="Input.Password" class="form-control" placeholder="Wpisz hasło" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Input.ConfirmPassword" class="form-label fw-bold">Potwierdź hasło</label>
                <input asp-for="Input.ConfirmPassword" class="form-control" placeholder="Powtórz hasło" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100 btn-lg">
                Zarejestruj się
            </button>
        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}