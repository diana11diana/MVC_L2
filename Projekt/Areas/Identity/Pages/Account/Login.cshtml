@page
@model Projekt.Areas.Identity.Pages.Account.LoginModel

@{
    ViewData["Title"] = "Logowanie";
    Layout = "/Views/Shared/_Layout.cshtml";
}

<div class="auth-login-page">

    <div class="auth-login-card">

        <div class="text-center mb-4">
            <div class="auth-login-icon">🏋️</div>

            <h1>Logowanie</h1>

            <p>
                Zaloguj się do swojego konta treningowego.
            </p>
        </div>

        <form method="post">

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label fw-bold">Email</label>
                <input asp-for="Input.Email"
                       class="form-control"
                       autocomplete="username"
                       placeholder="name@example.com" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Password" class="form-label fw-bold">Hasło</label>
                <input asp-for="Input.Password"
                       class="form-control"
                       autocomplete="current-password"
                       placeholder="Wpisz hasło" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <div class="form-check mb-4">
                <input asp-for="Input.RememberMe" class="form-check-input" />
                <label asp-for="Input.RememberMe" class="form-check-label">
                    Zapamiętaj mnie
                </label>
            </div>

            <button type="submit" class="btn btn-primary w-100 btn-lg">
                Zaloguj się
            </button>

            <div class="text-center mt-4">
                <span>Nie masz konta?</span>
                <a asp-page="./Register">
                    Zarejestruj się
                </a>
            </div>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<style>
    .auth-login-page {
        min-height: 75vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 50px 15px;
    }

    .auth-login-card {
        width: 100%;
        max-width: 520px;
        background: white;
        border-radius: 32px;
        padding: 46px;
        box-shadow: 0 25px 65px rgba(15, 23, 42, 0.18);
        border: 1px solid rgba(226, 232, 240, 0.9);
    }

    .auth-login-icon {
        width: 82px;
        height: 82px;
        margin: 0 auto 18px;
        border-radius: 26px;
        background: linear-gradient(135deg, #2563eb, #14b8a6);
        color: white;
        font-size: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 18px 40px rgba(37, 99, 235, 0.35);
    }

    .auth-login-card h1 {
        font-weight: 900;
        color: #0f172a;
    }

    .auth-login-card p {
        color: #64748b;
    }

    .auth-login-card .form-control {
        height: 56px;
        border-radius: 16px;
    }

    .auth-login-card .btn-primary {
        height: 56px;
        border-radius: 16px;
        font-weight: 800;
        background: linear-gradient(135deg, #2563eb, #14b8a6);
        border: none;
    }

    .auth-login-card a {
        font-weight: 700;
        color: #2563eb;
        text-decoration: none;
    }
</style>